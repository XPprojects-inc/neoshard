{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoShard",
  "version": "0.1.5",
  "identifier": "ru.neoshard.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -w @neoshard/web",
    "beforeBuildCommand": "npm run build -w @neoshard/web"
  },
  "app": {
    "windows": [{ "title": "NeoShard", "width": 1280, "height": 800, "minWidth": 940, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' ipc: http://ipc.localhost https: wss:; frame-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "SocialNetworking",
    "shortDescription": "Открытый мессенджер для сообществ",
    "licenseFile": "../../../LICENSE"
  }
}

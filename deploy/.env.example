# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -base64 32
NEOSHARD_DOMAIN=chat.example.ru
NEOSHARD_SECRET_KEY=
POSTGRES_PASSWORD=
LIVEKIT_API_KEY=neoshard
LIVEKIT_API_SECRET=
TURN_SECRET=
NEOSHARD_REGISTRATION_OPEN=true
# Federation (optional): NEOSHARD_FEDERATION=true and a 32-byte base64 Ed25519 seed
NEOSHARD_FEDERATION=false
NEOSHARD_FEDERATION_KEY=
# Object storage: Yandex Object Storage (S3_ENDPOINT=https://storage.yandexcloud.net)
# or the bundled MinIO (docker compose --profile local-s3 up -d)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=neoshard
S3_ACCESS_KEY=neoshard
S3_SECRET_KEY=
S3_PUBLIC_URL=
# Email for password recovery (self-hosted or Russian provider SMTP)
NEOSHARD_SMTP_URL=
NEOSHARD_SMTP_FROM=NeoShard <noreply@chat.example.ru>
GRAFANA_PASSWORD=
